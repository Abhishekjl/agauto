# Copy to backend/.env and fill in.
PORT=8787

# Point at any OpenAI-compatible endpoint:
#   OpenAI:      https://api.openai.com/v1
#   OpenRouter:  https://openrouter.ai/api/v1
#   Groq:        https://api.groq.com/openai/v1
#   Local vLLM:  http://127.0.0.1:8000/v1
#   Ollama:      http://127.0.0.1:11434/v1
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=sk-your-key-here

# Must support function calling (and vision for document extraction).
OPENAI_MODEL=gpt-4o-mini

# Embeddings for the semantic answer bank (Phase 5). May be a different
# endpoint/model than chat. Defaults to the OPENAI_* values if unset.
EMBED_BASE_URL=https://api.openai.com/v1
EMBED_API_KEY=sk-your-key-here
EMBED_MODEL=text-embedding-3-small
